  "components": {
    "schemas": {
      "ApprovalInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "TECNICA",
              "SEGURIDAD",
              "PROPIETARIO"
            ],
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "ApprovalInput"
      },
      "Content": {
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Summary"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Sections"
          },
          "steps": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array",
                "maxItems": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps"
          },
          "endpoints": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array",
                "maxItems": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Endpoints"
          },
          "threats": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array",
                "maxItems": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Threats"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "sections"
        ],
        "title": "Content"
      },
      "ContentUpdate": {
        "properties": {
          "content": {
            "$ref": "#/components/schemas/Content"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content",
          "expected_revision"
        ],
        "title": "ContentUpdate"
      },
      "DocumentInput": {
        "properties": {
          "number": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
            "title": "Number"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "content": {
            "$ref": "#/components/schemas/Content"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Title"
          },
          "kind": {
            "type": "string",
            "enum": [
              "RUNBOOK",
              "API",
              "SEGURIDAD"
            ],
            "title": "Kind"
          },
          "classification": {
            "type": "string",
            "enum": [
              "INTERNO",
              "RESTRINGIDO"
            ],
            "title": "Classification"
          },
          "owner_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Owner Id"
          },
          "project_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Project Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "expires_at",
          "content",
          "title",
          "kind",
          "classification",
          "owner_id",
          "project_id"
        ],
        "title": "DocumentInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "person_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Person Id"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "person_id",
          "password"
        ],
        "title": "Login"
      },
      "RenameDocument": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Title"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "expected_revision"
        ],
        "title": "RenameDocument"
      },
      "RequestInput": {
        "properties": {
          "version_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Version Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version_id"
        ],
        "title": "RequestInput"
      },
      "Section": {
        "properties": {
          "heading": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Heading"
          },
          "body": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 3,
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "heading",
          "body"
        ],
        "title": "Section"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionInput": {
        "properties": {
